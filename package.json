    "deploy": "npm run pages:build && npx wrangler pages deploy"
  },
  "dependencies": {
    "@next/third-parties": "^16.2.4",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.11.0",
    "next": "16.2.4",
    "openai": "^6.38.0",
    "pretendard": "^1.3.9",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "^1.13.16",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "typescript": "^6.0.3"
  }
}
