{
  "name": "lead-agency-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "check:edge-boundary": "node scripts/check-edge-import-boundary.mjs",
    "check:shorts-paths": "node scripts/check-shorts-producer-paths.mjs",
    "check:m0": "npm run check:edge-boundary && npm run check:shorts-paths",
    "pages:build": "npx @cloudflare/next-on-pages",
