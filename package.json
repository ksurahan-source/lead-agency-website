{
  "name": "lead-agency-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "check:edge-boundary": "node scripts/check-edge-import-boundary.mjs",
    "pages:build": "npx @cloudflare/next-on-pages",
    "preview": "npm run pages:build && npx wrangler pages dev",
    "deploy": "npm run pages:build && npx wrangler pages deploy",
    "help:build": "node help-center/build.mjs",
    "help:deploy": "npm run help:build && npx wrangler deploy --config help-center/wrangler.toml",
    "landing:build": "node landing/build.mjs",
    "landing:deploy": "npm run landing:build && npx wrangler deploy --config landing/wrangler.toml"
  },
  "dependencies": {
    "@next/third-parties": "^16.2.4",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.11.0",
    "next": "16.2.4",
    "pretendard": "^1.3.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1",
    "three": "0.186.0"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "^1.13.16",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "typescript": "^6.0.3",
    "wrangler": "^4.98.0"
  }
}
