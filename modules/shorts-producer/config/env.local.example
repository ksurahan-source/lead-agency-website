OPENAI_PREMIUM_MODEL=gpt-5.4
MAX_OUTPUT_TOKENS_PER_REQUEST=1200
ELEVENLABS_API_KEY=your_elevenlabs_key
PEXELS_API_KEY=your_pexels_key
AUTH_ALLOWED_EMAIL=your_email@example.com
AUTH_PASSWORD_SALT=hex_salt
AUTH_PASSWORD_HASH=pbkdf2_sha256_hash
AUTH_SESSION_SECRET=random_hex_secret
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
REMOTION_LAMBDA_FUNCTION_NAME=your_remotion_lambda_function
REMOTION_SERVE_URL=https://your-remotion-site.s3.amazonaws.com/sites/site-id/index.html
REMOTION_S3_BUCKET_NAME=your_remotion_bucket
REMOTION_RENDER_COMPOSITION_ID=ShortsComposition
REMOTION_RENDER_CALLBACK_SECRET=random_callback_secret
