DAILY_COST_LIMIT_USD=25
MAX_COST_PER_RUN_USD=5
MAX_COST_PER_ASSET_USD=2
MAX_RENDERS_PER_DAY=20
MAX_TTS_CHARS_PER_DAY=20000
MAX_IMAGE_GENERATIONS_PER_DAY=60
